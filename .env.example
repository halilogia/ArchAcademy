# Content Management System (optional)
# Point the app at a headless CMS that serves JSON collections.
# When unset, the app serves the bundled seed snapshot in src/infrastructure/cms/seed.
# Expected shape per collection: { collection, version, updatedAt, items: [...] }
# Request: GET ${VITE_CMS_ENDPOINT}/collections/{collection}
VITE_CMS_ENDPOINT=
VITE_CMS_TOKEN=
VITE_CMS_TIMEOUT_MS=6000

# Cloud progress sync (optional)
# Progress, quiz scores and sandbox designs are pushed to this REST endpoint.
# When unset, progress is only kept in the local offline cache.
# GET  ${VITE_PROGRESS_SYNC_ENDPOINT}/progress/{ownerId}
# PUT  ${VITE_PROGRESS_SYNC_ENDPOINT}/progress/{ownerId}
VITE_PROGRESS_SYNC_ENDPOINT=
VITE_PROGRESS_SYNC_TOKEN=
VITE_PROGRESS_SYNC_TIMEOUT_MS=8000
VITE_PROGRESS_USER_ID=local-learner

# Reference sync server (server/README.md) - these configure the SERVER, not the app.
# PORT=8787
# HOST=127.0.0.1
# SYNC_TOKEN=                 # shared bearer token for every owner
# SYNC_USER_TOKENS=alice:token-a,bob:token-b   # per-user tokens; *:token is an admin token
# SYNC_RATE_LIMIT=120        # requests per window per client
# SYNC_RATE_WINDOW_MS=60000
# SYNC_BACKEND=auto          # auto | file (SQLite when the runtime provides node:sqlite)

# Reference CMS server (server/README.md) - these configure the SERVER.
# CMS_PORT=8788
# CMS_HOST=127.0.0.1
# CMS_TOKEN=                  # bearer token required for every CMS read and write
# CMS_DATA_DIR=server/data/cms   # empty string serves the seed read only
# Deployment base path. Leave empty to use /ArchAcademy/ in CI and / locally.
# Must match the path the site is served from, otherwise assets and deep links break.
VITE_BASE_PATH=
